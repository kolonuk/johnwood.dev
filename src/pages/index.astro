---
import Layout from '../layouts/Layout.astro';
import resume from '../data/resume.json';

function formatDate(d?: string) {
  if (!d || d === 'Present') return d ?? '';
  const [year, month] = d.split('-');
  const date = new Date(Number(year), Number(month) - 1);
  return date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
}

const { basics, work, education, skills, projects } = resume;
const ORIGINAL_CV_URL = 'https://docs.google.com/document/d/1wID5t6_KAN1R91pGA1RLLY8QA2c2-najZRC3Mm8ymMA/edit?usp=sharing';
---

<Layout title={`${basics.name} — ${basics.label}`}>
  <header id="hero">
    <h1>{basics.name}</h1>
    <h2>{basics.label}</h2>
    <a class="btn" href="resume.pdf">Download CV (PDF)</a>
    <a class="btn-secondary" href={ORIGINAL_CV_URL} target="_blank" rel="noopener noreferrer">Original CV (Google Docs)</a>
  </header>

  <section id="about">
    <div class="container">
      <h2 class="heading">About Me</h2>
      <p class="lede">{basics.summary}</p>
    </div>
  </section>

  <section id="experience" class="alt">
    <div class="container">
      <h2 class="heading">Experience</h2>
      {work.map((job) => (
        <div class="entry">
          <h3>{job.company}</h3>
          <h4>{job.position}</h4>
          <span class="dates">{formatDate(job.startDate)} – {formatDate(job.endDate)}</span>
          <p>{job.summary}</p>
          <ul>
            {job.highlights?.map((h: string) => <li>{h}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section id="education">
    <div class="container">
      <h2 class="heading">Education</h2>
      {education.map((ed) => (
        <div class="entry">
          <h3>{ed.institution}</h3>
          <h4>{ed.studyType}{ed.area ? ` — ${ed.area}` : ''}</h4>
          <span class="dates">{formatDate(ed.startDate)} – {formatDate(ed.endDate)}</span>
          {ed.courses && <p>{ed.courses.join(', ')}</p>}
        </div>
      ))}
    </div>
  </section>

  <section id="projects" class="alt">
    <div class="container">
      <h2 class="heading">Notable Projects</h2>
      <div class="projects">
        {projects.map((proj) => (
          <div class="project">
            <h3>{proj.url ? <a href={proj.url} target="_blank" rel="noopener noreferrer">{proj.name}</a> : proj.name}</h3>
            <p>{proj.description}</p>
            <ul class="tags">
              {proj.keywords?.map((k: string) => <li>{k}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="skills">
    <div class="container">
      <h2 class="heading">Skills & Knowledge Areas</h2>
      {skills.map((group) => (
        <div class="skill-group">
          <h3>{group.name}</h3>
          <ul class="tags">
            {group.keywords.map((k: string) => <li>{k}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <footer id="contact">
    <h2 class="heading">Contact</h2>
    <p>
      Get in touch by email: <a id="contact-email" rel="nofollow">enable JavaScript to see email</a>,
      or use the form below:
    </p>
    <script define:vars={{ emailCodes: [...basics.email].map((c: string) => c.charCodeAt(0)) }}>
      const email = emailCodes.map((c) => String.fromCharCode(c)).join('');
      const a = document.getElementById('contact-email');
      a.href = `mailto:${email}`;
      a.textContent = email;
    </script>

    <form id="contact-form" method="post" action="/contact.php">
      <label for="from_email">Your email</label>
      <input type="email" id="from_email" name="from_email" placeholder="you@example.com" required />
      <label for="message">Message</label>
      <textarea id="message" name="message" rows="6" required></textarea>
      <div class="hp-field" aria-hidden="true">
        <label for="company">Company</label>
        <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
      </div>
      <label for="uniquecapture">Type "human" to prove you're not a bot</label>
      <input type="text" id="uniquecapture" name="uniquecapture" autocomplete="off" required />
      <div class="cf-turnstile" data-sitekey="0x4AAAAAAFeUl_N2ssXmfGCi"></div>
      <button type="submit">Send</button>
    </form>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <ul class="social">
      {basics.profiles.map((p) => (
        <li><a href={p.url} target="_blank" rel="noopener noreferrer">{p.network}</a></li>
      ))}
    </ul>
    <p class="copyright">© {new Date().getFullYear()} {basics.name}</p>
  </footer>
</Layout>
